# Copie este ficheiro para .env (não é versionado) e ajuste os valores.
# Em desenvolvimento:
DEBUG=1
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Em produção: DEBUG=0, uma SECRET_KEY longa e secreta, e o teu domínio, p. ex.:
#   DEBUG=0
#   SECRET_KEY=<gera uma: python -c "import secrets; print(secrets.token_urlsafe(50))">
#   ALLOWED_HOSTS=utilizador.pythonanywhere.com

# Limites do servidor (opcionais). Em alojamento fraco, baixa-os:
# FRACTOL_MAX_SIZE=900
# FRACTOL_MAX_ITER=300
# FRACTOL_CACHE_MB=32
